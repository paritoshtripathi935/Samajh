# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.
# The frontend talks to the Python backend; Sarvam's key lives on the backend.

# ── Python backend base URL ─────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Supabase (public — safe in the browser; RLS applies) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
