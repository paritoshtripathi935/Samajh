# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.
# The Next.js frontend proxies `/api/*` to the Python backend; Sarvam's key
# lives on the backend.

# ── Python backend base URL ─────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000

# ── Supabase (public — safe in the browser; RLS applies) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
