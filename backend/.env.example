# Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# ── Sarvam ──────────────────────────────────────────────────────────────────
# Base https://api.sarvam.ai · header `api-subscription-key` · auth fail = 403.
SARVAM_API_KEY=
# Split PDFs over 10 pages and process batches concurrently with this cap.
SARVAM_DI_MAX_WORKERS=3

# ── Contextual legal search (migrated from MiniHarvey) ──────────────────────
INDIAN_KANOON_API_TOKEN=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
MAX_SEARCH_RESULTS=10

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
# The key the client uses. Anon key is fine while RLS policies are open (demo).
SUPABASE_KEY=
# Optional: for production, set the service_role key (bypasses RLS) — it wins
# over SUPABASE_KEY when present. Get it from Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket containing original uploaded PDFs.
SUPABASE_DOCUMENTS_BUCKET=documents

# ── CORS: where the Next.js frontend is served ──────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
