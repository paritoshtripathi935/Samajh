# Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# ── Sarvam ──────────────────────────────────────────────────────────────────
# Base https://api.sarvam.ai · header `api-subscription-key` · auth fail = 403.
SARVAM_API_KEY=

# ── Supabase (server-side; service role bypasses RLS) ───────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS: where the Next.js frontend is served ──────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
